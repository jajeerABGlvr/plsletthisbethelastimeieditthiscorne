#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        new_behavior: new_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "NEW_BEHAVIOR";
            bindings = <&to>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <275>;
            flavor = "balanced";
        };

        commaapostrophe: new_behaviorr {
            compatible = "zmk,behavior-hold-tap";
            label = "comma,apostophe";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <247>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESCAPE        &kp Q  &kp W  &kp E                         &kp R      &kp T      &kp Y          &kp U      &kp I                              &kp O                               &kp P                                    &kp MINUS
&kp TAB           &kp A  &kp S  &kp D                         &kp F      &kp G      &kp H          &kp J      &kp K                              &kp L                               &commaapostrophe LEFT_BRACKET SEMICOLON  &kp RIGHT_BRACKET
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C                         &kp V      &kp B      &kp N          &kp M      &commaapostrophe APOSTROPHE COMMA  &commaapostrophe DOT DOUBLE_QUOTES  &kp FSLH                                 &kp RIGHT_SHIFT
                                &new_behavior 1 LEFT_COMMAND  &kp LSHFT  &kp SPACE  &kp BACKSPACE  &kp ENTER  &kp RIGHT_COMMAND
            >;
        };

        layer_1 {
            bindings = <
&none             &kp SLASH          &kp N0     &kp N1  &kp N2  &kp N3          &none          &none           &kp UP_ARROW  &none      &none  &none
&none             &kp X              &kp PLUS   &kp N4  &kp N5  &kp N6          &none          &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &none  &none
&kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp MINUS  &kp N7  &kp N8  &kp N9          &none          &none           &none         &none      &none  &none
                                                &to 0   &kp AT  &kp LEFT_SHIFT  &kp BACKSPACE  &kp ENTER       &kp SPACE
            >;
        };
    };
};
